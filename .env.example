# ==========================================
# NexDesk AI — Production Environment Variables
# ==========================================

# Core Application Settings
PROJECT_NAME="NexDesk AI"
VERSION="0.1.0"
ENVIRONMENT="production"
API_V1_STR="/api"

# AI Inference (Groq)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET="production_secret_key_minimum_32_characters_long"

# Databases
# For SQLite (local/dev/single-node):
# DATABASE_URL="sqlite:///./nexdesk.db"
# For Managed PostgreSQL (Render, Neon, Supabase, Railway):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vector Store
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://nexdesk.vercel.app","https://your-frontend-domain.com"]

# SMTP Email Dispatch (Gmail SMTP / SendGrid / AWS SES)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="balaji.poet2312s@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM_EMAIL="balaji.poet2312s@gmail.com"
SMTP_FROM_NAME="NexDesk AI – IT Service Desk"
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL="balaji.poet2312s@gmail.com"
ADMIN_EMAIL="balaji.poet2312s@gmail.com"

# Public URLs
FRONTEND_BASE_URL="https://nexdesk.vercel.app"
BACKEND_PUBLIC_URL="https://nexdesk-backend.onrender.com"

# ==========================================
# Frontend Environment Variables (frontend/.env)
# ==========================================
# VITE_API_URL="https://nexdesk-backend.onrender.com/api"
